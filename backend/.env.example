# PostgreSQL connection string. Use a managed PostgreSQL service in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marks_savanna_stock
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5500
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d

# Daraja sandbox credentials from your Safaricom Developer Portal sandbox app.
# Keep all secrets server-side; never put them in browser JavaScript or Git.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Must be a public HTTPS URL reachable by Safaricom. For local development,
# expose the API using a secure tunnel and use its HTTPS callback URL.
MPESA_CALLBACK_URL=https://your-public-host.example/api/payments/mpesa/stk/callback
MPESA_C2B_VALIDATION_URL=https://your-public-host.example/api/payments/mpesa/c2b/validate
MPESA_C2B_CONFIRMATION_URL=https://your-public-host.example/api/payments/mpesa/c2b/confirm
